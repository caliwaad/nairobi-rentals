# ============================================================
# Nairobi Rentals — Phase 0 environment checklist
# Copy this file to .env (server) / .env.local (mobile, if needed)
# and fill in each value. NEVER commit real keys.
# `EXPO_PUBLIC_*` vars are inlined into the mobile app bundle —
# only put client-safe values there (publishable keys, DSNs, maps keys).
# ============================================================

# ─── Expo / EAS ─────────────────────────────────────────────
# https://expo.dev/settings/access-tokens  (only needed for non-interactive eas login)
EXPO_TOKEN=

# ─── Clerk (auth) ───────────────────────────────────────────
# https://dashboard.clerk.com → your app → API Keys
# IMPORTANT: in this monorepo Expo reads env from apps/mobile/.env —
# copy this file there (or at least add the key) before restarting the
# dev server, or the Profile tab shows the "Auth not configured" notice.
# Publishable key goes in the app bundle (public by design):
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Secret key stays server-side only:
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# Webhook signing secret (Dashboard → Webhooks → Endpoints):
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx
#
# Dashboard steps to enable Google + Apple sign-in:
#   1. dashboard.clerk.com → Users & Authentication → SSO connections → Add connection → Google
#      (dev instances use Clerk's shared credentials — nothing else needed for development)
#   2. Repeat for Apple.
#   3. Add your dev origin to Redirect URLs (e.g. http://localhost:8081) so the
#      sso-callback redirect is allowed.
#   4. (Native builds) Enable the Native API under Native applications and add the app's
#      bundle id / package name.

# ─── Neon (Postgres) ────────────────────────────────────────
# https://console.neon.tech → project → connection string (pooled recommended)
DATABASE_URL=postgresql://USER:PASS@ep-xxxx.eu-central-1.aws.neon.tech/nairobi-rentals?sslmode=require

# ─── Cloudinary (images) ────────────────────────────────────
# https://console.cloudinary.com → Account → API Keys
CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxx
# Signed-upload signature is built server-side; preset is optional.

# ─── Google Cloud (Maps + Places) ───────────────────────────
# https://console.cloud.google.com → create project → enable:
#   "Maps SDK for Android", "Maps SDK for iOS", "Places API (New)"
# Restrict each key to the app's package/bundle id.
GOOGLE_MAPS_ANDROID_API_KEY=AIzaxxxxxxxx
GOOGLE_MAPS_IOS_API_KEY=AIzaxxxxxxxx
GOOGLE_PLACES_API_KEY=AIzaxxxxxxxx

# ─── Resend (email) ─────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# From address — verify your domain in Resend first:
EMAIL_FROM=Nairobi Rentals <no-reply@yourdomain.com>

# ─── trigger.dev (background jobs) ──────────────────────────
# https://trigger.dev → project → Environments → API Keys
TRIGGER_API_KEY=tr_xxxxxxxx
TRIGGER_PROJECT_REF=your-project-ref

# ─── Sentry (monitoring) ────────────────────────────────────
# Create two projects: "mobile" (client DSN) and "web" (server DSN).
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@o1.ingest.sentry.io/xxxx
SENTRY_DSN=https://xxxx@o1.ingest.sentry.io/xxxx
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx

# ─── IntaSend (M-Pesa payments) ─────────────────────────────
# https://intasend.com → API Keys (use SANDBOX keys for development;
# live keys + KYC at go-live)
INTASEND_PUBLISHABLE_KEY=xxxxxxxx
INTASEND_SECRET_KEY=xxxxxxxx

# ─── Product config ─────────────────────────────────────────
# Monthly realtor subscription price in KES (absorbs 3% M-Pesa fee):
REALTOR_SUBSCRIPTION_PRICE_KES=1500
