# Copy to apps/mobile/.env (gitignored) and fill in real values.

# Clerk — https://dashboard.clerk.com → your app → API keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_…

# Cloudinary image uploads — https://cloudinary.com/console → Dashboard
# Cloud name (cloud_name) and an UNSIGNED upload preset:
#   Settings → Upload → "Add upload preset" → Mode: Unsigned
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# API base URL. Production is the Vercel deployment; during local dev you can
# point this at http://localhost:3000 (native) or your LAN IP.
# NOTE: EXPO_PUBLIC_* vars are inlined at bundle time — restart Metro after
# changing this, and rebuild the APK for a phone install to pick it up.
EXPO_PUBLIC_API_URL=https://nairobi-rentals-web.vercel.app
