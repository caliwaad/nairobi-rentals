# Copy to apps/web/.env.local (gitignored) and fill in real values.
# The same four variables go into Vercel: Project → Settings → Environment Variables.

# Neon Postgres — https://console.neon.tech → your project → Connect → pooled connection string
DATABASE_URL=postgresql://…

# Clerk — https://dashboard.clerk.com → your app → API keys
CLERK_SECRET_KEY=sk_test_…
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_…

# Clerk webhook signing secret — dashboard.clerk.com → Webhooks → your endpoint → Signing secret
CLERK_WEBHOOK_SECRET=whsec_…

# IntaSend (M-Pesa payments) — https://intasend.com → API Keys
# Use SANDBOX keys for development; live keys + KYC at go-live.
INTASEND_PUBLISHABLE_KEY=xxxxxxxx
INTASEND_SECRET_KEY=xxxxxxxx
# "sandbox" (default) or "live" — switches the API base URL.
INTASEND_ENV=sandbox
# The exact challenge string you set on the IntaSend dashboard → Webhooks.
# IntaSend embeds it in every payload; we verify it (PLAN §4-7).
INTASEND_WEBHOOK_CHALLENGE=your-webhook-challenge

# Monthly realtor subscription price in KES — the charged amount absorbs the
# 3% M-Pesa fee (rounded up), so the realtor nets the listed price.
REALTOR_SUBSCRIPTION_PRICE_KES=1500
