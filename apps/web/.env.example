# Copy to apps/web/.env.local (gitignored) and fill in real values.
# The same four variables go into Vercel: Project → Settings → Environment Variables.

# Neon Postgres — https://console.neon.tech → your project → Connect → pooled connection string
DATABASE_URL=postgresql://…

# Clerk — https://dashboard.clerk.com → your app → API keys
CLERK_SECRET_KEY=sk_test_…
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_…

# Clerk webhook signing secret — dashboard.clerk.com → Webhooks → your endpoint → Signing secret
CLERK_WEBHOOK_SECRET=whsec_…
